{
  "manifest_version": 3,
  "name": "Akra Player for YouTube",
  "version": "2.4",
  "description": "Lets Akra Player play/pause YouTube (and other tabs) with its global keys, even while you're in a game.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Akra Player",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  }
}
